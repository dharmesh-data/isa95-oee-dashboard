        { "refId": "B", "rawSql": "SELECT time, performance * 100 as \"LINE-B\" FROM oee_metrics WHERE line_id = 'LINE-B' AND $__timeFilter(time) ORDER BY time", "format": "time_series" },
        { "refId": "C", "rawSql": "SELECT time, performance * 100 as \"LINE-C\" FROM oee_metrics WHERE line_id = 'LINE-C' AND $__timeFilter(time) ORDER BY time", "format": "time_series" }
