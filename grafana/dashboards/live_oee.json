      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "targets": [
        { "refId": "A", "rawSql": "SELECT time, quality * 100 as \"LINE-A\" FROM oee_metrics WHERE line_id = 'LINE-A' AND $__timeFilter(time) ORDER BY time", "format": "time_series" },
        { "refId": "B", "rawSql": "SELECT time, quality * 100 as \"LINE-B\" FROM oee_metrics WHERE line_id = 'LINE-B' AND $__timeFilter(time) ORDER BY time", "format": "time_series" },
